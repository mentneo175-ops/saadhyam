# Application
APP_NAME=Website Generator Microservice
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/website_generator
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage (local, s3, minio)
STORAGE_TYPE=local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=website-generator
LOCAL_STORAGE_PATH=./output

# AI/LLM
AI_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2
AI_USE_FAKE_LLM=true
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.7
HF_TOKEN=

# Security
API_KEYS=dev-key-12345,prod-key-67890
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=100

# Docker
DB_PASSWORD=postgres123
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123
