FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy lightweight requirements for free tier
COPY requirements-free.txt ./requirements.txt

# Install only essential Python dependencies (no heavy ML packages)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Make entrypoint.sh executable
RUN chmod +x entrypoint.sh

# Create minimal directories
RUN mkdir -p /app/logs /app/cache

# Create non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE $PORT

# Minimal health check
HEALTHCHECK --interval=120s --timeout=30s --start-period=30s --retries=2 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Run application
CMD ["./entrypoint.sh"]
