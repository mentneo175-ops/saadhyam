    "649b10ad-1838-4b66-bfc9-08e521f5ecd6": {
      "website_id": "649b10ad-1838-4b66-bfc9-08e521f5ecd6",
      "content": {
        "html": "<html lang=\"en\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>The office | Parallax Scroll Layout</title>\n    <link rel=\"stylesheet\" href=\"/website-ai/static/theme-adapter.css\">\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Montserrat', sans-serif;\n            background: #0a0a0a;\n            color: #ffffff;\n            overflow-x: hidden;\n        }\n\n        /* Fixed header */\n        .fixed-header {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            background: rgba(10, 10, 10, 0.9);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n        }\n\n        .header-inner {\n            max-width: 1600px;\n            margin: 0 auto;\n            padding: 24px 60px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .logo {\n            font-size: 24px;\n            font-weight: 800;\n            background: linear-gradient(135deg, #00f5a0, #00d9f5);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 48px;\n            list-style: none;\n        }\n\n        .nav-menu a {\n            color: rgba(255, 255, 255, 0.7);\n            text-decoration: none;\n            font-size: 14px;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            transition: all 0.3s;\n            position: relative;\n        }\n\n        .nav-menu a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: linear-gradient(90deg, #00f5a0, #00d9f5);\n            transition: width 0.3s;\n        }\n\n        .nav-menu a:hover {\n            color: #00f5a0;\n        }\n\n        .nav-menu a:hover::after {\n            width: 100%;\n        }\n\n        /* Parallax hero */\n        .parallax-hero {\n            height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .parallax-bg {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 120%;\n            background: radial-gradient(circle at 30% 50%, rgba(0, 245, 160, 0.15), transparent 50%),\n                radial-gradient(circle at 70% 50%, rgba(0, 217, 245, 0.15), transparent 50%);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        @keyframes float {\n\n            0%,\n            100% {\n                transform: translateY(0) scale(1);\n            }\n\n            50% {\n                transform: translateY(-30px) scale(1.05);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            text-align: center;\n            max-width: 1000px;\n            padding: 0 40px;\n        }\n\n        .hero-label {\n            display: inline-block;\n            padding: 12px 28px;\n            border: 2px solid rgba(0, 245, 160, 0.3);\n            border-radius: 50px;\n            font-size: 13px;\n            font-weight: 700;\n            text-transform: uppercase;\n            letter-spacing: 3px;\n            margin-bottom: 40px;\n            background: rgba(0, 245, 160, 0.05);\n            color: #00f5a0;\n        }\n\n        .hero-content h1 {\n            font-size: 96px;\n            font-weight: 900;\n            line-height: 1;\n            margin-bottom: 32px;\n            letter-spacing: -4px;\n            background: linear-gradient(135deg, #ffffff 0%, #00f5a0 100%);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            animation: fadeInUp 1s ease-out;\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-content p {\n            font-size: 24px;\n            color: rgba(255, 255, 255, 0.7);\n            margin-bottom: 48px;\n            line-height: 1.6;\n            animation: fadeInUp 1s ease-out 0.2s both;\n        }\n\n        .hero-cta {\n            display: inline-block;\n            padding: 20px 48px;\n            background: linear-gradient(135deg, #00f5a0, #00d9f5);\n            color: #0a0a0a;\n            text-decoration: none;\n            border-radius: 50px;\n            font-weight: 800;\n            font-size: 16px;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            box-shadow: 0 20px 60px rgba(0, 245, 160, 0.3);\n            transition: all 0.4s;\n            animation: fadeInUp 1s ease-out 0.4s both;\n        }\n\n        .hero-cta:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 30px 80px rgba(0, 245, 160, 0.4);\n        }\n\n        /* Scroll sections */\n        .scroll-section {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: 120px 60px;\n            position: relative;\n        }\n\n        .section-content {\n            max-width: 1400px;\n            margin: 0 auto;\n            width: 100%;\n        }\n\n        .section-title {\n            font-size: 72px;\n            font-weight: 900;\n            margin-bottom: 80px;\n            text-align: center;\n            letter-spacing: -3px;\n            background: linear-gradient(135deg, #ffffff, #00f5a0);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        /* Service cards */\n        .service-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\n            gap: 40px;\n        }\n\n        .service-card {\n            background: linear-gradient(135deg, rgba(0, 245, 160, 0.05), rgba(0, 217, 245, 0.05));\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            border-radius: 24px;\n            padding: 48px;\n            transition: all 0.5s;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: -100%;\n            width: 100%;\n            height: 100%;\n            background: linear-gradient(90deg, transparent, rgba(0, 245, 160, 0.1), transparent);\n            transition: left 0.5s;\n        }\n\n        .service-card:hover::before {\n            left: 100%;\n        }\n\n        .service-card:hover {\n            transform: translateY(-12px);\n            border-color: rgba(0, 245, 160, 0.5);\n            box-shadow: 0 30px 80px rgba(0, 245, 160, 0.2);\n        }\n\n        .service-number {\n            font-size: 80px;\n            font-weight: 900;\n            color: rgba(0, 245, 160, 0.2);\n            line-height: 1;\n            margin-bottom: 24px;\n        }\n\n        .service-card h3 {\n            font-size: 32px;\n            margin-bottom: 20px;\n            color: #00f5a0;\n        }\n\n        .service-card p {\n            font-size: 18px;\n            color: rgba(255, 255, 255, 0.7);\n            line-height: 1.8;\n        }\n\n        /* FAQ section */\n        .faq-container {\n            max-width: 1000px;\n            margin: 0 auto;\n        }\n\n        .faq-item {\n            background: rgba(255, 255, 255, 0.03);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            border-radius: 20px;\n            padding: 36px;\n            margin-bottom: 24px;\n            transition: all 0.3s;\n        }\n\n        .faq-item:hover {\n            background: rgba(0, 245, 160, 0.05);\n            border-color: rgba(0, 245, 160, 0.3);\n        }\n\n        .faq-item summary {\n            font-size: 24px;\n            font-weight: 700;\n            cursor: pointer;\n            list-style: none;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            color: #ffffff;\n        }\n\n        .faq-item summary::after {\n            content: '\u25bc';\n            font-size: 16px;\n            color: #00f5a0;\n            transition: transform 0.3s;\n        }\n\n        .faq-item[open] summary::after {\n            transform: rotate(180deg);\n        }\n\n        .faq-item p {\n            margin-top: 24px;\n            font-size: 18px;\n            color: rgba(255, 255, 255, 0.7);\n            line-height: 1.8;\n        }\n\n        /* Contact section */\n        .contact-section {\n            background: linear-gradient(135deg, rgba(0, 245, 160, 0.1), rgba(0, 217, 245, 0.1));\n            border: 2px solid rgba(0, 245, 160, 0.3);\n            border-radius: 40px;\n            padding: 100px 60px;\n            text-align: center;\n            max-width: 1000px;\n            margin: 0 auto;\n        }\n\n        .contact-section h2 {\n            font-size: 64px;\n            font-weight: 900;\n            margin-bottom: 32px;\n            background: linear-gradient(135deg, #00f5a0, #00d9f5);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .contact-section p {\n            font-size: 22px;\n            color: rgba(255, 255, 255, 0.8);\n            line-height: 1.7;\n        }\n\n        @media (max-width: 1024px) {\n            .hero-content h1 {\n                font-size: 56px;\n            }\n\n            .service-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .section-title {\n                font-size: 48px;\n            }\n        }\n    </style>\n    <script src=\"/website-ai/static/editor.js\" defer=\"\"></script>\n\n    <script>\n        // Website ID for editor\n        window.WEBSITE_ID = '649b10ad-1838-4b66-bfc9-08e521f5ecd6';\n        console.log('\ud83c\udd94 Website ID:', window.WEBSITE_ID);\n    </script>\n\n    <script>\n        // Website ID for editor\n        window.WEBSITE_ID = '649b10ad-1838-4b66-bfc9-08e521f5ecd6';\n        console.log('\ud83c\udd94 Website ID:', window.WEBSITE_ID);\n    </script>\n</head>\n\n<body data-theme=\"parallax-scroll\">\n    <header class=\"fixed-header\">\n        <div class=\"header-inner\">\n            <div class=\"logo\">The office</div>\n            <nav>\n                <ul class=\"nav-menu\">\n                    <li><a href=\"#services\">Services</a></li>\n                    <li><a href=\"blogs.html\">Blog</a></li>\n                    <li><a href=\"#faq\">FAQ</a></li>\n                    <li><a href=\"#contact\">Contact</a></li>\n                </ul>\n            </nav>\n        </div>\n    </header>\n\n    <section class=\"parallax-hero\">\n        <div class=\"parallax-bg\"></div>\n        <div class=\"hero-content\">\n            <span class=\"hero-label\">Service</span>\n            <h1>The office for modern customers</h1>\n            <p>The office is a Service built for customers looking for a reliable, modern brand experience. The brand feels professional, engaging, and trustworthy and reflects modern business.</p>\n            <a href=\"#services\" class=\"hero-cta\">Request a custom quote</a>\n        </div>\n    </section>\n\n    <section id=\"services\" class=\"scroll-section\">\n        <div class=\"section-content\">\n            <h2 class=\"section-title\">Our Services</h2>\n            <div class=\"service-grid\">\n                <div class=\"service-card\">\n                    <div class=\"service-number\">01</div>\n                    <h3>Core service two</h3>\n                    <p>Tailored core service two for customers looking for a reliable, modern brand experience.</p>\n                </div>\n                <div class=\"service-card\">\n                    <div class=\"service-number\">02</div>\n                    <h3>Core service four</h3>\n                    <p>Tailored core service four for customers looking for a reliable, modern brand experience.</p>\n                </div>\n                <div class=\"service-card\">\n                    <div class=\"service-number\">03</div>\n                    <h3>Core service three</h3>\n                    <p>Tailored core service three for customers looking for a reliable, modern brand experience.</p>\n                </div>\n                <div class=\"service-card\">\n                    <div class=\"service-number\">04</div>\n                    <h3>Core service one</h3>\n                    <p>Tailored core service one for customers looking for a reliable, modern brand experience.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"faq\" class=\"scroll-section\">\n        <div class=\"section-content\">\n            <h2 class=\"section-title\">FAQ</h2>\n            <div class=\"faq-container\">\n                <details class=\"faq-item\">\n                    <summary>What makes The office different?</summary>\n                    <p>It blends modern business with a professional, engaging, and trustworthy customer experience.</p>\n                </details>\n                <details class=\"faq-item\">\n                    <summary>How do I get started?</summary>\n                    <p>Choose a service, reach out, and we will guide you through the next step.</p>\n                </details>\n                <details class=\"faq-item\">\n                    <summary>Who is this for?</summary>\n                    <p>It is designed for customers looking for a reliable, modern brand experience.</p>\n                </details>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"contact\" class=\"scroll-section\">\n        <div class=\"section-content\">\n            <div class=\"contact-section\">\n                <h2>Ready to Start?</h2>\n                <p>Contact The office to schedule a consultation or request a quote.</p>\n            </div>\n        </div>\n    </section>\n\n\n</body></html>"
